{
  "name": "universal-code-agent",
  "version": "0.1.0",
  "description": "Universal MCP coding-agent connector: GitHub, filesystem, sandboxed terminal, Codespaces, mobile dashboard.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "universal-code-agent": "dist/cli.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js http",
    "start:stdio": "node dist/cli.js stdio",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "dev": "tsc -w -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
